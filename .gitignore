# --- 项目原有 ---
/.cuda-name
/build

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
*.egg

# --- 虚拟环境 / 包管理 ---
.venv/
venv/
.env
.env.*

# --- Hugging Face 本地缓存（默认 <repo>/hf_cache，见 output_paths.py）---
hf_cache/
# Encoder-only export (~22G fp32); regenerate with scripts/export_t5_encoder_only.py
hf_cache/t5-11b-encoder/
.locks/

# --- HF xet 传输日志 ---
xet/

# --- 评测 / 验证输出 ---
rollouts/
validation_outputs/
cosmos_policy/experiments/robot/**/logs/
cosmos_policy/experiments/robot/**/json_logs/

# --- VLA4Desk / Franka 本地数据（HDF5、T5 pkl 体积大，勿入库）---
/datasets/
*.hdf5
**/t5_embeddings.pkl

# vla4desk/: 仅入库 *.txt（如 prompts.txt）；collected/、*.pkl 等保持本地
vla4desk/*
!vla4desk/*.txt

# --- 训练 / 实验常见产物（预防性）---
wandb/
outputs/
checkpoints/
*.ckpt
*.pt
!**/config.json

# --- IDE / 系统 ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- 测试 / 类型检查缓存 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
